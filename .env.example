# ---------------------------------------------------------------------------
# Clinzo Scheduling — environment template.
# Copy to `.env` and fill in real values. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
SHUTDOWN_TIMEOUT_MS=15000

# PostgreSQL (Prisma). Inside docker-compose use host `postgres`.
DATABASE_URL=postgresql://clinzo:clinzo@localhost:5432/clinzo?schema=public&connection_limit=20&pool_timeout=10

# Redis. Inside docker-compose use host `redis`.
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=clinzo.health
JWT_AUDIENCE=clinzo.api

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (per window, per identity)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_MAX=30

# Scheduling domain defaults
DEFAULT_SLOT_DURATION_MINUTES=15
DEFAULT_BUFFER_MINUTES=0
RESERVATION_HOLD_TTL_SECONDS=120
SLOT_GENERATION_HORIZON_DAYS=60
MAX_SLOTS_PER_GENERATION=5000
MIN_BOOKING_LEAD_MINUTES=0

# Distributed locking
LOCK_TTL_MS=5000
LOCK_ACQUIRE_TIMEOUT_MS=3000
LOCK_RETRY_DELAY_MS=40

# Caching
SLOT_CACHE_TTL_SECONDS=15

# Background jobs
BULLMQ_PREFIX=clinzo
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100
WORKER_CONCURRENCY=10

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Observability
METRICS_ENABLED=true
